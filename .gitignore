# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# OS
.DS_Store

# Build artifacts of this project — the persisted vector index is
# regenerated by the ingestion script (commit 4), not something to track.
data/index/
data/processed/

# RHPs pulled by data/scrape_sebi_rhps.py — regenerate via the scraper
# rather than tracking large PDFs in git.
data/raw/*.pdf

# GMP snapshot from data/scrape_gmp.py — live market data, stale within
# minutes, re-scrape rather than track.
data/gmp/

# Subscription/anchor-investor snapshot from data/scrape_subscription.py —
# same live-data reasoning as data/gmp/.
data/subscription/

# Listing-performance snapshot + tracked daily history from
# data/scrape_listing_performance.py. Unlike the other two snapshots,
# history.jsonl is *accumulated* state (see src/listing_performance_answerer.py),
# not just a disposable cache — but it's still locally-scraped, per-machine
# data, not something to track in git.
data/listing_performance/

# Local secrets / env overrides, if any get added later
.env
